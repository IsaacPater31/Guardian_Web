rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function signedIn() {
      return request.auth != null;
    }

    function callerIsSuspended() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('suspended', false) == true;
    }

    // --- Reglas ---
    // Paso seguro desde "allow if true":
    // - Lectura: igual que antes (abierta).
    // - Escritura: abierta SOLO si NO eres un usuario logueado y suspendido.
    // Así el admin web (sin login) sigue funcionando, y Guardian/Usersweb
    // suspendidos no pueden escribir aunque tengan token Auth.
    match /{document=**} {
      allow read: if true;
      allow write: if !callerIsSuspended();
    }
  }
}
